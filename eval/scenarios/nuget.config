<?xml version="1.0" encoding="utf-8"?>
<!--
  Hermetic package sources for this repository: ignore machine-level feeds (private/company feeds would
  trigger NU1507 with central package management and can require credentials). Everything comes from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
